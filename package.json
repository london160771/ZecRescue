{
  "name": "zecrescue",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev:api": "tsx server/src/main.ts",
    "dev:agent": "tsx agent/src/main.ts",
    "build:api": "tsc -p tsconfig.api.json",
    "build:contracts": "node contracts/scripts/compile.mjs",
    "test:contracts": "vitest run contracts/tests/rescue-router.test.ts",
    "start:api": "node --env-file-if-exists=.env dist/server/src/main.js",
    "build:agent": "tsc -p tsconfig.agent.json",
    "start:agent": "node --env-file-if-exists=.env dist/agent/src/main.js",
    "phase0:near-chain": "tsx phase0/scripts/near-chained-route.ts",
    "phase0:mainnet": "tsc -p phase0/tsconfig.runner.json && node --env-file-if-exists=.env dist/phase0-runner/scripts/mainnet-runner-server.js"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.25",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "mongoose": "8.24.3",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@types/express": "5.0.6",
    "@types/node": "22.18.6",
    "eslint": "9.35.0",
    "solc": "^0.8.36",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
