# Optional Base mainnet RPC override for the local Phase 0 runner / API.
BASE_RPC_URL=https://mainnet.base.org

# Optional Arbitrum One mainnet RPC override for the backend.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Backend orchestration database. Use a private MongoDB Atlas URI in deployment.
MONGODB_URI=mongodb://127.0.0.1:27017/zecrescue

# Server-only relayer key. Replace locally; never put this value in frontend config.
RELAYER_PRIVATE_KEY=replace-with-server-side-relayer-private-key

# Exact frontend origin allowed to call the API in production.
WEB_ORIGIN=https://your-frontend.example

# Number of trusted reverse-proxy hops used to recover the real client IP.
# Render deployments usually set this from their current proxy topology.
TRUST_PROXY_HOPS=0

# Minimum provider-bound rescue amount in native USDC base units (6 decimals).
MIN_RESCUE_USDC_MICRO=1000000

# Audited, deployed RescueRouter addresses. The API fails closed if unset.
BASE_RESCUE_ROUTER_ADDRESS=
ARBITRUM_RESCUE_ROUTER_ADDRESS=
BASE_RESCUE_ROUTER_CODE_HASH=
ARBITRUM_RESCUE_ROUTER_CODE_HASH=

# Per-chain fixed reimbursement and estimated native relay-cost ceilings.
# Operators must choose these after measured chain-specific fee review.
BASE_MAX_REIMBURSEMENT_USDC_MICRO=
ARBITRUM_MAX_REIMBURSEMENT_USDC_MICRO=
BASE_MAX_RELAY_GAS_COST_WEI=
ARBITRUM_MAX_RELAY_GAS_COST_WEI=

# Optional 1Click partner key. Without one, quotes use the unauthenticated fee schedule.
NEAR_INTENTS_API_KEY=replace-with-server-side-near-intents-key

# Optional API listener port (defaults to 8787).
PORT=8787

# Public frontend configuration. These values are not secrets.
# Leave API URL empty in local Vite development to use its /api proxy.
VITE_API_BASE_URL=
VITE_LOCAL_AGENT_URL=http://127.0.0.1:4180

# Phase 0 harness safety gates. Keep disabled unless the user explicitly starts a test.
PHASE0_BASE_MAINNET_PASS=0
PHASE0_ENABLE_ARBITRUM=0

# Optional local zecrescue-agent listener (always binds to 127.0.0.1).
ZECRESCUE_AGENT_PORT=4180
ZECRESCUE_AGENT_TOKEN=replace-with-a-random-local-token-at-least-32-bytes
ZECRESCUE_AGENT_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional installed Zingo PC native runtime path. Defaults to the standard Windows install location.
# The agent pins the expected version and SHA-256; mismatches fail closed.
ZINGO_PC_NATIVE_PATH=

# Configure all three only for an EXISTING Mainnet wallet created by the user in Zingo PC.
# Zingo PC must be closed before the agent opens the same wallet directory.
ZINGO_WALLET_BASE_DIR=C:/path/to/existing/zingo-wallet-directory
ZINGO_WALLET_NAME=zingo-wallet.dat
ZINGO_LIGHTWALLETD_URI=https://lightwalletd.example:9067

# Optional local-only receiver-to-chain registry path; defaults under %LOCALAPPDATA%/ZecRescue/agent.
ZECRESCUE_AGENT_STATE_DIR=

# Set to 1 only if this is a dedicated Recovery Vault without unrelated transparent funds.
ZINGO_RECOVERY_WALLET_DEDICATED=0

# Hard safety gate for account-level shield signing/broadcast. Remains 0 until the owner
# has verified the local wallet runtime and the account-level privacy disclosure is accepted.
ZINGO_SHIELDING_RUNTIME_VERIFIED=0
